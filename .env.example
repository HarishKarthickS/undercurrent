NODE_ENV=development
DEPLOYMENT_MODE=closed_demo
ENABLE_DEV_FIXTURES=false
DEMO_TERMS_VERSION=closed-demo-v1
# SHA-256 of the reviewed closed-demo terms document. Required in production.
DEMO_TERMS_SHA256=
PORT=3001
DATABASE_URL=postgresql://undercurrent:undercurrent@localhost:5432/undercurrent
REDIS_URL=redis://localhost:6379
TRUST_PROXY=false
BODY_LIMIT_BYTES=16384
REQUEST_TIMEOUT_MS=90000
KEEP_ALIVE_TIMEOUT_MS=72000
CONNECTION_TIMEOUT_MS=90000
ALLOWED_ORIGINS=http://localhost:5173
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_DOCKER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/free
AI_REQUEST_TIMEOUT_MS=45000
REQUEST_TIMEOUT_MS=90000
CONNECTION_TIMEOUT_MS=90000
AI_DAILY_TURN_LIMIT=24
# Local/dev only. Defaults to true outside production.
DISABLE_DAILY_RITUAL_LIMIT=true
PARENT_ADVISOR_DAILY_TURN_LIMIT=12
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1
SMTP_URL=
MAIL_FROM=Undercurrent <no-reply@example.com>
PUBLIC_APP_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
MAX_EVENT_LOOP_DELAY_MS=1000
HEALTH_CHECK_INTERVAL_MS=5000
MAX_CONCURRENT_REQUESTS=50
BETA_MODE=local
TRUST_PROXY=false
# Set AUTH_MODE=auth0 only after Auth0 is configured with guardian verification and tenant claims.
AUTH_MODE=local
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_HOUSEHOLD_CLAIM=https://undercurrent.app/households
AUTH0_ROLES_CLAIM=https://undercurrent.app/roles
# Optional overrides for `npm run seed` / `seed:direct` demo parent login.
PARENT_TEST_EMAIL=
PARENT_TEST_PASSWORD=
